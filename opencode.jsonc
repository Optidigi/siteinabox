{
  "$schema": "https://opencode.ai/config.json",
  "permissions": [
    {
      "action": "cloudflare-api_*",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "openprovider_*",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "openprovider_check_domain",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "openprovider_decode_csr",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "openprovider_get_contact",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "openprovider_get_customer",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "openprovider_get_dmarc",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "openprovider_get_dns_template",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "openprovider_get_dns_zone",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "openprovider_get_domain",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "openprovider_get_domain_price",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "openprovider_get_nameserver",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "openprovider_get_ns_group",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "openprovider_get_plesk_license",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "openprovider_get_spam_experts_domain",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "openprovider_get_ssl_approver_emails",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "openprovider_get_ssl_order",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "openprovider_get_ssl_product",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "openprovider_get_tld",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "openprovider_list_contacts",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "openprovider_list_customers",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "openprovider_list_dmarc_subscriptions",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "openprovider_list_dns_templates",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "openprovider_list_dns_zone_records",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "openprovider_list_dns_zones",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "openprovider_list_domains",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "openprovider_list_email_templates",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "openprovider_list_email_verification_domains",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "openprovider_list_license_items",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "openprovider_list_license_prices",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "openprovider_list_nameservers",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "openprovider_list_ns_groups",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "openprovider_list_pending_confirmations",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "openprovider_list_plesk_licenses",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "openprovider_list_ssl_orders",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "openprovider_list_ssl_products",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "openprovider_list_tags",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "openprovider_list_tlds",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "openprovider_suggest_domain",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "posthog_*",
      "resource": "*",
      "effect": "ask"
    }
  ],
  "mcp": {
    "servers": {
      "cloudflare-api": {
        "type": "remote",
        "url": "https://mcp.cloudflare.com/mcp",
        "oauth": {
          "scope": "user:read account:read"
        }
      },
      "openprovider": {
        "type": "remote",
        "url": "https://mcp.openprovider.com/mcp",
        "oauth": {
          "scope": "mcp:read"
        }
      },
      "posthog": {
        "type": "remote",
        "url": "https://mcp.posthog.com/mcp",
        "headers": {
          "x-posthog-read-only": "true"
        }
      }
    }
  }
}
