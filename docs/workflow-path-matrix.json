{
  "schemaVersion": 1,
  "scope": "minimum path coverage for deployable image workflows",
  "workflows": {
    "build-cms-image.yml": {
      "application": "cms",
      "requiredPaths": [
        "apps/cms/**",
        "packages/contracts/**",
        "packages/legal-content/**",
        "packages/site-renderer/**",
        "packages/ui/**",
        "package.json",
        "pnpm-lock.yaml",
        "pnpm-workspace.yaml",
        ".github/workflows/build-cms-image.yml",
        ".dockerignore",
        ".nvmrc",
        "scripts/check-publication.mjs",
        "scripts/check-required-ci.mjs",
        "scripts/check-dependency-security.mjs",
        "docs/dependency-security.json",
        "ops/github/main-ruleset.json"
      ]
    },
    "build-renderer-image.yml": {
      "application": "renderer",
      "requiredPaths": [
        "apps/renderer/**",
        "packages/contracts/**",
        "packages/legal-content/**",
        "packages/site-renderer/**",
        "packages/ui/**",
        "package.json",
        "pnpm-lock.yaml",
        "pnpm-workspace.yaml",
        ".dockerignore",
        ".github/workflows/build-renderer-image.yml",
        ".nvmrc",
        "scripts/check-publication.mjs",
        "scripts/check-required-ci.mjs",
        "scripts/check-dependency-security.mjs",
        "docs/dependency-security.json",
        "ops/github/main-ruleset.json"
      ]
    },
    "build-site-image.yml": {
      "application": "site",
      "requiredPaths": [
        "apps/landing/**",
        "packages/contracts/**",
        "packages/legal-content/**",
        "package.json",
        "pnpm-lock.yaml",
        "pnpm-workspace.yaml",
        ".dockerignore",
        ".github/workflows/build-site-image.yml",
        ".nvmrc",
        "scripts/check-publication.mjs",
        "scripts/check-required-ci.mjs",
        "scripts/check-dependency-security.mjs",
        "docs/dependency-security.json",
        "ops/github/main-ruleset.json"
      ]
    }
  }
}
