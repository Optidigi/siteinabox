    "github": {
      "purpose": "Read-only hosted repository, issue, pull-request, and Actions research.",
      "transport": "stdio",
      "command": "docker",
      "args": [
        "run",
        "-i",
        "--rm",
        "-e",
        "GITHUB_PERSONAL_ACCESS_TOKEN",
        "-e",
        "GITHUB_READ_ONLY",
        "-e",
        "GITHUB_TOOLSETS",
        "ghcr.io/github/github-mcp-server@sha256:2b0c48b070f61e9d3969269ead600f62d00fb237b60ac849ef3d166ee7de9ad3",
        "stdio"
      ],
      "implementation": {
        "kind": "container",
        "identifier": "ghcr.io/github/github-mcp-server",
        "version": "1.6.0",
        "digest": "sha256:2b0c48b070f61e9d3969269ead600f62d00fb237b60ac849ef3d166ee7de9ad3"
      },
      "requiredEnv": ["GITHUB_PERSONAL_ACCESS_TOKEN"],
      "staticEnv": {
        "GITHUB_READ_ONLY": "1",
        "GITHUB_TOOLSETS": "repos,issues,pull_requests,actions"
      },
      "staticHeaders": {},
      "secretHeaders": {},
      "serverPolicy": {
        "readOnly": { "required": true, "enforcement": { "kind": "environment", "value": "GITHUB_READ_ONLY" } },
        "toolsets": {
          "required": true,
          "values": ["repos", "issues", "pull_requests", "actions"],
          "enforcement": { "kind": "environment", "value": "GITHUB_TOOLSETS" }
        },
        "toolAllowlist": { "required": false, "values": [], "enforcement": null }
      },
      "clientPolicy": {
        "defaultEnabled": true,
        "approval": { "required": false, "mode": "auto" },
        "enabledTools": { "required": false, "values": [] },
        "disabledTools": { "required": false, "values": [] }
      },
      "preconditions": ["A user-local token is optional; do not create one merely to start the server."],
      "projectionTargets": ["codex", "cursor"],
      "fallback": "Use git, gh read-only commands, or GitHub primary documentation."
    },
    "openprovider": {
      "purpose": "Approved Openprovider domain, DNS, SSL, and account investigation; provider mutations require explicit approval.",
      "transport": "http",
      "url": "https://mcp.openprovider.com/mcp",
      "implementation": {
        "kind": "remote",
        "identifier": "https://mcp.openprovider.com/mcp",
        "version": "provider-managed",
        "reviewedAt": "2026-10-22",
        "unpinnedReason": "The provider exposes a managed remote endpoint rather than a versioned local executable."
      },
      "requiredEnv": ["OPENPROVIDER_MCP_AUTHORIZATION"],
      "staticEnv": {},
      "staticHeaders": {},
      "secretHeaders": {
        "Authorization": "OPENPROVIDER_MCP_AUTHORIZATION"
      },
      "serverPolicy": {
        "readOnly": { "required": false, "enforcement": null },
        "toolsets": { "required": false, "values": [], "enforcement": null },
        "toolAllowlist": { "required": false, "values": [], "enforcement": null }
      },
      "clientPolicy": {
        "defaultEnabled": true,
        "approval": { "required": true, "mode": "prompt" },
        "enabledTools": { "required": false, "values": [] },
        "disabledTools": { "required": false, "values": [] },
        "opencode": {
          "auth": { "kind": "oauth", "scope": "mcp:read" },
          "toolAllowlist": {
            "required": true,
            "values": [
              "check_domain",
              "decode_csr",
              "get_contact",
              "get_customer",
              "get_dmarc",
              "get_dns_template",
              "get_dns_zone",
              "get_domain",
              "get_domain_price",
              "get_nameserver",
              "get_ns_group",
              "get_plesk_license",
              "get_ssl_approver_emails",
              "get_ssl_order",
              "get_ssl_product",
              "get_spam_experts_domain",
              "get_tld",
              "list_contacts",
              "list_customers",
              "list_dmarc_subscriptions",
              "list_dns_templates",
              "list_dns_zone_records",
              "list_dns_zones",
              "list_domains",
              "list_email_templates",
              "list_email_verification_domains",
              "list_license_items",
              "list_license_prices",
              "list_nameservers",
              "list_ns_groups",
              "list_pending_confirmations",
              "list_plesk_licenses",
              "list_ssl_orders",
              "list_ssl_products",
              "list_tags",
              "list_tlds",
              "suggest_domain"
            ]
          }
        }
      },
      "preconditions": [
        "Set user-local OPENPROVIDER_MCP_AUTHORIZATION to Bearer <op_live_…> from https://mcp.openprovider.com/dashboard (API keys) only for the Codex and Cursor projections; do not use application OPENPROVIDER_* credentials or commit the key.",
        "OpenCode uses the Openprovider OAuth flow with the server-enforced mcp:read scope instead of the API key; complete browser sign-in from the user-scope MCP interface.",
        "The OpenCode projection denies every tool outside the reviewed read-only allowlist. Review that allowlist against the live tools/list catalog whenever the provider changes.",
        "Use read-only inspection first. Any external-provider write, including DNS, domain, SSL, customer, contact, email, or license changes, requires explicit approval."
      ],
      "projectionTargets": ["codex", "cursor", "opencode"],
      "fallback": "Use the repository Openprovider integration and Openprovider primary documentation; do not mutate the provider."
    },
    "postgres": {
      "purpose": "Bounded read-only database inspection with a dedicated database role.",
      "transport": "stdio",
      "command": "npx",
      "args": ["-y", "@bytebase/dbhub@0.23.0", "--transport", "stdio", "--config", ".mcp/dbhub-postgres.toml"],
      "workingDirectory": "repositoryRoot",
      "implementation": {
        "kind": "npm",
        "identifier": "@bytebase/dbhub",
        "version": "0.23.0"
      },
      "requiredEnv": ["SIAB_MCP_POSTGRES_URL"],
      "staticEnv": {},
      "staticHeaders": {},
      "secretHeaders": {},
      "serverPolicy": {
        "readOnly": {
          "required": true,
          "enforcement": { "kind": "generatedConfig", "value": "tools.execute_sql.readonly" }
        },
        "toolsets": { "required": false, "values": [], "enforcement": null },
        "toolAllowlist": {
          "required": true,
          "values": ["execute_sql", "search_objects"],
          "enforcement": { "kind": "generatedConfig", "value": "tools" }
        }
      },
      "clientPolicy": {
        "defaultEnabled": false,
        "approval": { "required": false, "mode": "auto" },
        "enabledTools": { "required": false, "values": [] },
        "disabledTools": { "required": false, "values": [] }
      },
      "runtimeConfig": {
        "kind": "dbhub",
        "path": ".mcp/dbhub-postgres.toml",
        "source": {
          "id": "siab",
          "dsnEnv": "SIAB_MCP_POSTGRES_URL",
          "connectionTimeoutSeconds": 10,
          "queryTimeoutSeconds": 15
        },
        "executeSql": { "readOnly": true, "maxRows": 100 },
        "exposeSearchObjects": true
      },
      "preconditions": [
        "Keep disabled until an owner creates a dedicated siab_mcp_readonly role and user-local SIAB_MCP_POSTGRES_URL.",
        "The role must not be the Payload application role and must have only CONNECT, intended-schema USAGE, and intended-relation SELECT.",
        "Do not target production by default; database permissions remain the primary security boundary and do not reproduce application tenancy."
      ],
      "projectionTargets": ["codex"],
      "fallback": "Use approved psql read-only inspection with a dedicated database role."
    },
