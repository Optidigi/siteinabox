---
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/siab/Header.astro';
import Footer from '../components/siab/Footer.astro';
import FaqSection from '../components/siab/FaqSection.astro';
import DevicePreview from '../components/siab/DevicePreview.astro';
import BentoIcon from '../components/siab/BentoIcon.astro';
import { PricingTabs } from '../components/siab/PricingTabs';
import { Testimonials } from '../components/siab/Testimonials';
import { buttonVariants } from '../components/ui/button';
import { Card } from '../components/ui/card';

const home = await getEntry('pages', 'index');
if (!home) throw new Error('Missing required content entry: pages/index');

const ctaSignup = '/intake/';
const professions = ['kapper', 'schilder', 'coach', 'fotograaf', 'hovenier', 'personal trainer', 'loodgieter', 'klusser', 'schoonheidsspecialist', 'timmerman', 'stukadoor', 'kok'];
const guarantees = [
  { title: 'Jij levert input, wij bouwen', text: "Een 15 minuten vragenlijst en wat foto's. Wij verwerken het tot je website.", color: 'text-yellow', shadow: 'bg-yellow', paths: ['M9 5h6', 'M9 9h6', 'M9 13h4', 'M5 3h14v18H5z'] },
  { title: 'Privacy en cookies geregeld', text: 'Inclusief een passende privacyverklaring en cookiemelding voor je Site in a Box-website.', color: 'text-green', shadow: 'bg-green', paths: ['M12 3 5 6v5c0 5 3 8 7 10 4-2 7-5 7-10V6l-7-3', 'm9 12 2 2 4-4'] },
  { title: 'Aanpassen kan altijd', text: "Tekst, foto's of openingstijden? Pas zelf aan via je beheeromgeving.", color: 'text-orange', shadow: 'bg-orange', paths: ['M4 20h4l11-11-4-4L4 16v4', 'm13.5 6.5 4 4'] },
];
const comparisonRows = [
  { label: 'Tijd van jou', iconPaths: ['M12 12m-9 0a9 9 0 1 0 18 0a9 9 0 1 0 -18 0', 'M12 7v5l3 3'], selfBuild: 'Veel', agency: 'Intake + feedback', siteInABox: '± 15 minuten' },
  { label: 'Tijd tot livegang', iconPaths: ['M4 7a2 2 0 0 1 2 -2h12a2 2 0 0 1 2 2v12a2 2 0 0 1 -2 2h-12a2 2 0 0 1 -2 -2v-12', 'M16 3v4', 'M8 3v4', 'M4 11h16'], selfBuild: 'Wanneer jij klaar bent', agency: 'Vaak meerdere weken', siteInABox: 'Binnen 3 werkdagen' },
  { label: 'Investering vooraf', iconPaths: ['M17 8v-3a1 1 0 0 0 -1 -1h-10a2 2 0 0 0 0 4h12a1 1 0 0 1 1 1v3m0 4v3a1 1 0 0 1 -1 1h-12a2 2 0 0 1 -2 -2v-12', 'M12 12m-1.5 0a1.5 1.5 0 1 0 3 0a1.5 1.5 0 1 0 -3 0'], selfBuild: 'Laag in geld, hoog in tijd', agency: 'Hoger projectbedrag', siteInABox: 'Geen opstartkosten' },
  { label: 'Techniek na oplevering', iconPaths: ['M10.325 4.317c.426 -1.756 2.924 -1.756 3.35 0a1.724 1.724 0 0 0 2.573 1.066c1.543 -.94 3.31 .826 2.37 2.37a1.724 1.724 0 0 0 1.065 2.572c1.756 .426 1.756 2.924 0 3.35a1.724 1.724 0 0 0 -1.066 2.573c.94 1.543 -.826 3.31 -2.37 2.37a1.724 1.724 0 0 0 -2.572 1.065c-.426 1.756 -2.924 1.756 -3.35 0a1.724 1.724 0 0 0 -2.573 -1.066c-1.543 .94 -3.31 -.826 -2.37 -2.37a1.724 1.724 0 0 0 -1.065 -2.572c-1.756 -.426 -1.756 -2.924 0 -3.35a1.724 1.724 0 0 0 1.066 -2.573c-.94 -1.543 .826 -3.31 2.37 -2.37c1 .608 2.296 .07 2.572 -1.065', 'M12 12m-3 0a3 3 0 1 0 6 0a3 3 0 1 0 -6 0'], selfBuild: 'Zelf regelen', agency: 'Afhankelijk van afspraken', siteInABox: 'Inbegrepen' },
  { label: 'Beste keuze voor', iconPaths: ['M12 12m-1 0a1 1 0 1 0 2 0a1 1 0 1 0 -2 0', 'M12 12m-5 0a5 5 0 1 0 10 0a5 5 0 1 0 -10 0', 'M12 12m-9 0a9 9 0 1 0 18 0a9 9 0 1 0 -18 0'], selfBuild: 'Handige doeners', agency: 'Complex maatwerk', siteInABox: 'Snel en zorgeloos online' },
];
---

<BaseLayout title={home.data.title} description={home.data.description} ogImage={home.data.ogImage} hasFaq>
  <Header />
  <main>
    <div class="bg-cream dark:bg-background">
      <section class="relative pb-36 pt-28 md:pb-44 md:pt-36 lg:pb-32 lg:pt-36" aria-label="Introductie" data-analytics-section="hero" data-analytics-position="1">
        <div class="site-container grid items-center gap-8 lg:grid-cols-2 lg:gap-5">
          <div class="relative z-10">
            <h1 class="max-w-[570px] text-[clamp(3.25rem,6.1vw,5.9rem)] font-medium leading-[.88] tracking-[-.055em]">Een website voor je bedrijf. <br class="hidden md:block" />Zonder gedoe.</h1>
            <p class="mt-8 text-[17px] font-medium leading-relaxed text-muted-foreground md:text-2xl md:text-foreground">Voorbeeld binnen 24 uur · Geen startkosten · €19 p/m</p>
            <div class="mt-7 flex flex-wrap items-center gap-4 md:gap-6">
              <a
                href={ctaSignup}
                class={buttonVariants({ size: 'lg', className: 'min-h-[60px] min-w-[220px]' })}
                data-analytics-component="cta-start-intake-hero"
                data-analytics-component-type="cta"
                data-analytics-component-role="primary"
                data-analytics-action="start_intake"
                data-analytics-placement="hero"
                data-analytics-destination="intake"
                data-analytics-conversion="true"
                data-analytics-conversion-source="intake_handoff"
              >Maak mijn website</a>
              <a
                href="#zo-werkt-het"
                class="inline-flex min-h-[60px] items-center font-body text-lg font-bold text-muted-foreground underline decoration-2 decoration-dashed underline-offset-[5px]"
                data-analytics-action="view_how_it_works"
                data-analytics-placement="hero"
                data-analytics-destination="section"
              >Hoe werkt het? →</a>
            </div>
          </div>
          <div id="hero-rocket" class="mx-auto aspect-[4/3] w-full max-w-[680px] lg:origin-left" role="img" aria-label="Animatie: jouw bedrijfswebsite klaar voor lancering"></div>
        </div>
      </section>

      <section class="bg-plum pb-14 text-white md:pb-10" aria-labelledby="eerst-zien-heading" data-analytics-section="process" data-analytics-position="2">
        <h2 id="eerst-zien-heading" class="sr-only">Eerst zien, dan betalen</h2>
        <div class="site-container -translate-y-24">
          <div class="grid gap-7 lg:grid-cols-3">
            <Card as="article" className="min-h-[410px] border-black bg-card text-card-foreground shadow-md lg:min-h-0">
              <div class="p-6 md:p-7">
                <div class="flex items-center gap-4">
                  <span class="grid size-12 place-items-center rounded-full border-2 border-black bg-cyan font-head text-xl font-bold text-black">1</span>
                  <h3 class="text-2xl tracking-[-.02em]">Jij vult in</h3>
                </div>
                <p class="mt-4 leading-relaxed text-muted-foreground">Een vragenlijst van een kwartier en wat foto’s. Meer niet.</p>
              </div>
              <div data-process-visual class="mx-6 mb-6 mt-auto h-[210px] overflow-hidden border-2 border-border bg-muted p-2.5 lg:h-[200px]">
                <div data-process-form class="flex h-full min-h-0 flex-col justify-between gap-1 overflow-hidden border-2 border-border bg-card p-2 shadow-[2px_2px_0_#090709]">
                  <p class="flex items-center gap-1.5 font-head text-sm font-extrabold leading-none"><img src="/theme/images/icon/tabler-clipboard-list.svg" alt="" width="16" height="16" />Vragenlijst</p>
                  <div class="flex flex-col gap-0.5">
                    <p class="text-[10px] leading-none">Bedrijfsnaam</p>
                    <div class="flex min-h-7 items-center border-2 border-border bg-input px-2 py-1 text-[13px] leading-tight">Jouw Bedrijf<span class="ml-0.5 inline-block h-4 border-l border-current motion-safe:animate-pulse"></span></div>
                  </div>
                  <div class="flex flex-col gap-0.5">
                    <p class="text-[10px] leading-none">Wat doe je?</p>
                    <div class="flex min-h-7 items-center border-2 border-border bg-input px-2 py-1 text-[13px] leading-tight">Diensten &amp; aanpak</div>
                  </div>
                  <div class="flex flex-col gap-0.5">
                    <p class="text-[10px] leading-none">Foto’s</p>
                    <div data-process-photos class="grid grid-cols-3 gap-1.5">
                      <span class="grid min-h-7 place-items-center border-2 border-border bg-cyan"><img src="/theme/images/icon/tabler-check.svg" alt="" width="14" height="14" /></span>
                      <span class="grid min-h-7 place-items-center border-2 border-border bg-orange"><img src="/theme/images/icon/tabler-check.svg" alt="" width="14" height="14" /></span>
                      <span class="grid min-h-7 place-items-center border-2 border-border bg-card"><img src="/theme/images/icon/tabler-plus.svg" alt="" width="14" height="14" /></span>
                    </div>
                  </div>
                </div>
              </div>
            </Card>

            <Card as="article" className="min-h-[410px] border-black bg-card text-card-foreground shadow-md lg:min-h-0">
              <div class="p-6 md:p-7">
                <div class="flex items-center gap-4">
                  <span class="grid size-12 place-items-center rounded-full border-2 border-black bg-orange font-head text-xl font-bold text-black">2</span>
                  <h3 class="text-2xl tracking-[-.02em]">Wij maken je site</h3>
                </div>
                <p class="mt-4 leading-relaxed text-muted-foreground">Binnen 24 uur zie je hoe jouw website eruitziet.</p>
              </div>
              <div data-process-visual class="mx-6 mb-6 mt-auto flex h-[210px] flex-col overflow-hidden border-2 border-border bg-muted lg:h-[200px]">
                <div class="flex items-center gap-2 border-b-2 border-border px-3 py-2">
                  <span class="flex gap-1" aria-hidden="true"><i class="size-2 rounded-full bg-orange"></i><i class="size-2 rounded-full bg-yellow"></i><i class="size-2 rounded-full bg-green"></i></span>
                  <span class="min-w-0 flex-1 border border-border bg-card px-2 py-0.5 text-[9px]">jouwbedrijf.nl/preview</span>
                </div>
                <img src="/theme/images/assets/example-desktop.webp" alt="" width="600" height="375" class="min-h-0 w-full flex-1 object-cover object-top" />
              </div>
            </Card>

            <Card as="article" className="min-h-[410px] border-black bg-card text-card-foreground shadow-md lg:min-h-0">
              <div class="p-6 md:p-7">
                <div class="flex items-center gap-4">
                  <span class="grid size-12 place-items-center rounded-full border-2 border-black bg-green font-head text-xl font-bold text-black">3</span>
                  <h3 class="text-2xl tracking-[-.02em]">Jij beslist</h3>
                </div>
                <p class="mt-4 leading-relaxed text-muted-foreground">Tevreden? Live. Zo niet? Niks betalen.</p>
              </div>
              <div data-process-visual class="mx-6 mb-6 mt-auto grid h-[210px] grid-cols-2 place-items-center gap-7 border-2 border-border bg-muted px-4 pb-5 pt-7 lg:h-[200px]">
                <span class="relative grid size-[68px] place-items-center rounded-full border-2 border-black bg-green text-black shadow-sm">
                  <span class="pointer-events-none absolute inset-0" aria-hidden="true">
                    <i class="absolute left-1/2 top-1/2 h-0.5 w-2.5 origin-left rounded-sm bg-black [transform:rotate(-122deg)_translateX(42px)]"></i>
                    <i class="absolute left-1/2 top-1/2 h-0.5 w-3 origin-left rounded-sm bg-black [transform:rotate(-90deg)_translateX(44px)]"></i>
                    <i class="absolute left-1/2 top-1/2 h-0.5 w-2.5 origin-left rounded-sm bg-black [transform:rotate(-58deg)_translateX(42px)]"></i>
                  </span>
                  <svg class="size-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.8"><path d="M20 6 9 17l-5-5"></path></svg>
                </span>
                <span class="relative grid size-[68px] place-items-center rounded-full border-2 border-black bg-orange text-black shadow-sm">
                  <span class="pointer-events-none absolute inset-0" aria-hidden="true">
                    <i class="absolute left-1/2 top-1/2 h-0.5 w-2.5 origin-left rounded-sm bg-black [transform:rotate(-122deg)_translateX(42px)]"></i>
                    <i class="absolute left-1/2 top-1/2 h-0.5 w-3 origin-left rounded-sm bg-black [transform:rotate(-90deg)_translateX(44px)]"></i>
                    <i class="absolute left-1/2 top-1/2 h-0.5 w-2.5 origin-left rounded-sm bg-black [transform:rotate(-58deg)_translateX(42px)]"></i>
                  </span>
                  <svg class="size-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.8"><path d="m18 6-12 12M6 6l12 12"></path></svg>
                </span>
              </div>
            </Card>
          </div>
        </div>

        <div class="site-container pt-7 text-center md:pt-10">
          <h2 class="font-medium text-[clamp(26px,3.8vw,44px)] leading-[1.15] tracking-[-.015em]">Voor elke starter die professioneel online wil staan.</h2>
          <div class="mt-6 h-[72px] overflow-hidden border-2 border-black bg-white/[.21] md:mt-8 md:h-[94px]">
            <p class="sr-only">Voor deze beroepen werken wij: {professions.join(', ')}.</p>
            <div class="h-full overflow-hidden [mask-image:linear-gradient(90deg,transparent_0,#000_80px_calc(100%-80px),transparent_100%)]" aria-hidden="true">
              <div class="siab-marquee-track flex h-full w-max items-center">
                {[0, 1].map(() => (
                  <div data-marquee-group class="flex h-full shrink-0 items-center px-8">
                    {professions.map((profession) => <span class="mx-6 shrink-0 font-body text-[17px] font-medium text-white md:mx-10 md:text-xl">{profession}</span>)}
                  </div>
                ))}
              </div>
            </div>
          </div>
          <ul class="mt-5 flex flex-col items-center justify-center gap-3 text-[15px] font-medium text-white/90 md:mt-6 md:flex-row md:flex-wrap md:gap-x-10 md:text-base">
            <li class="inline-flex items-center gap-2.5"><svg class="size-5 shrink-0 text-yellow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg>Klaar voor Google én ChatGPT</li>
            <li class="inline-flex items-center gap-2.5"><svg class="size-5 shrink-0 text-yellow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg>Zelf aanpassen, zonder technische kennis</li>
            <li class="inline-flex items-center gap-2.5"><svg class="size-5 shrink-0 text-yellow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg>Niet tevreden? Geen factuur.</li>
          </ul>
        </div>
      </section>
    </div>

    <section id="zo-werkt-het" class="py-20 md:py-0 lg:mt-20 min-[1200px]:mt-[150px] min-[1400px]:mt-[180px]" aria-labelledby="zo-werkt-het-heading" data-analytics-section="how_it_works" data-analytics-position="3">
      <div class="site-container">
        <h2 id="zo-werkt-het-heading" class="mb-10 text-center text-[42px] leading-[1.1029] min-[1200px]:!mb-20 min-[1200px]:!text-[52px] min-[1400px]:!text-[68px]">Zo werkt het.</h2>
        <div class="siab-bento-grid grid gap-[30px] min-[1200px]:gap-y-[50px]">
          <Card as="article" className="min-h-[250px] justify-between border-black bg-[#f6f6f6] p-6 text-black shadow-[4px_4px_0_#090709] dark:bg-white/[.07] dark:text-foreground md:p-8 lg:col-span-4 lg:justify-start lg:px-[15px] lg:py-5 min-[1200px]:!px-[45px] min-[1200px]:!pb-[50px] min-[1200px]:!pt-[76px]">
            <BentoIcon name="shield" />
            <h3 class="text-[26px] !font-medium leading-[1.238] lg:mt-10 min-[1200px]:!mt-[90px] min-[1200px]:!text-[35px] min-[1400px]:!text-[42px]">Een vragenlijst van een kwartier, meer niet.</h3>
          </Card>
          <Card as="article" className="min-h-[300px] overflow-hidden border-black bg-[#1f4531] p-6 text-white shadow-[4px_4px_0_#090709] dark:bg-white/[.07] md:p-7 lg:col-span-8 lg:px-[15px] lg:pb-0 lg:pt-5 min-[1200px]:!px-20 min-[1200px]:!pb-0 min-[1200px]:!pt-[60px]">
            <h3 class="mb-7 text-[26px] !font-medium leading-[1.208] text-white lg:mb-2 min-[1200px]:!w-[calc((200%-24px)/3)] min-[1200px]:!text-[35px] min-[1400px]:!text-[48px]">Zo ziet een website van Site in a Box eruit.</h3>
            <DevicePreview />
          </Card>
          <Card as="article" className="relative min-h-[270px] overflow-hidden border-black bg-[#cde1ff] p-6 text-black shadow-[4px_4px_0_#090709] dark:bg-white/[.07] dark:text-foreground md:p-8 lg:col-span-8 lg:min-h-[460px] lg:px-10 lg:py-20 lg:pb-[120px] min-[1400px]:!px-20">
            <div class="relative z-10 ml-auto max-w-full text-right md:max-w-2/3 min-[1200px]:!w-[calc((200%-24px)/3)] min-[1200px]:!max-w-none">
              <span class="ml-auto grid size-14 place-items-center rounded-full border-2 border-black bg-yellow lg:size-[70px]"><img src="/theme/images/icon/icon_54.svg" alt="" width="28" height="28" /></span>
              <blockquote class="mb-0 mt-5 text-[26px] font-medium leading-[1.444] lg:mb-[45px] lg:mt-[25px] lg:text-[24px] min-[1200px]:!text-[28px] min-[1400px]:!text-[32px]">“Strak, modern en mooi design. Mensen merken het op.<br />Een echte aanrader.”</blockquote>
            </div>
            <img src="/theme/images/assets/avatar_woman.webp" alt="" width="640" height="960" class="absolute bottom-0 left-[6.5%] hidden h-[96%] w-auto max-w-[46%] object-contain object-bottom md:block lg:left-[1%] lg:h-[78%] min-[1400px]:!left-[6.5%] min-[1400px]:!h-[96%]" loading="lazy" />
            <img data-bento-stars src="/theme/images/shape/shape_80.svg" alt="" width="481" height="343" class="absolute left-[6%] top-[14%] hidden w-1/2 max-w-[50%] md:block" />
          </Card>
          <Card as="article" className="min-h-[250px] justify-center border-black bg-[#f6f6f6] p-6 text-black shadow-[4px_4px_0_#090709] dark:bg-white/[.07] dark:text-foreground md:p-8 lg:col-span-4 lg:min-h-[460px] lg:px-[15px] lg:py-5 min-[1200px]:!px-[45px] min-[1200px]:!py-[50px]">
            <h3 class="mb-10 text-[26px] !font-medium leading-[1.238] min-[1200px]:mb-[90px] min-[1200px]:!text-[28px] min-[1400px]:!text-[42px]">Eerste versie binnen 24 uur, online binnen 3 werkdagen.</h3>
            <BentoIcon name="speed" />
          </Card>
        </div>
      </div>
    </section>

    <section class="pb-20 md:mt-[180px] md:pb-32" aria-labelledby="garanties-heading" data-analytics-section="guarantees" data-analytics-position="4">
      <div class="site-container border-y-2 border-border py-14 md:py-20">
        <h2 id="garanties-heading" class="sr-only">Onze garanties</h2>
        <div class="grid gap-12 md:grid-cols-3">
          {guarantees.map((item) => (
            <article class="text-center">
              <span class="relative mx-auto block h-[75px] w-[68px]" aria-hidden="true">
                <i class:list={['absolute left-1/2 top-2 size-[67px] -translate-x-1/2 rounded-full dark:hidden', item.shadow]}></i>
                <i class:list={['absolute left-1/2 top-0 grid size-[67px] -translate-x-1/2 place-items-center rounded-full border-2 border-transparent bg-black dark:border-current dark:bg-[#07142d]', item.color]}>
                  <svg class="size-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">{item.paths.map((path) => <path d={path}></path>)}</svg>
                </i>
              </span>
              <h3 class="mt-5 text-xl md:text-2xl">{item.title}</h3>
              <p class="mx-auto mt-3 max-w-sm text-sm leading-relaxed text-muted-foreground md:text-base">{item.text}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="prijzen" class="py-16 md:mt-[120px] md:py-0" aria-labelledby="prijzen-heading" data-analytics-section="pricing" data-analytics-position="5">
      <PricingTabs client:visible intakeHref={ctaSignup} />
    </section>

    <section class="relative overflow-hidden bg-plum pb-36 pt-20 text-white md:mt-[140px] md:pb-[260px] md:pt-[100px]" aria-labelledby="klanten-heading" data-analytics-section="testimonials" data-analytics-position="6">
      <div class="site-container mb-12 text-center md:mb-[70px]">
        <h2 id="klanten-heading" class="text-5xl md:text-7xl">Onze klanten</h2>
        <p class="mt-3 text-lg text-white/75 md:text-2xl">We vroegen ze hoe het ging. Dit kwam terug.</p>
      </div>
      <Testimonials client:visible />
      <img src="/theme/images/shape/shape_81.svg" alt="" width="1472" height="35" class="pointer-events-none absolute left-1/2 top-[19%] w-[80%] max-w-none -translate-x-1/2" />
    </section>

    <section id="vergelijking" class="pb-0 pt-24 md:mt-[180px] md:pb-12 md:pt-0" aria-labelledby="vergelijking-heading" data-analytics-section="comparison" data-analytics-position="7">
      <div class="site-container">
        <div class="mx-auto mb-10 max-w-2xl text-center">
          <h2 id="vergelijking-heading" class="text-5xl md:text-6xl">Wat past bij jou?</h2>
          <p id="vergelijking-uitleg" class="mt-4 text-lg text-muted-foreground">Niet elke route past bij elk bedrijf. Vergelijk tijd, verantwoordelijkheid en investering.</p>
        </div>

        <Card as="div" className="overflow-hidden rounded-none border-black bg-card shadow-[4px_4px_0_#090709] dark:border-border dark:shadow-[4px_4px_0_#5a2b46]">
          <table class="w-full table-fixed border-collapse" aria-describedby="vergelijking-uitleg">
            <caption class="sr-only">Vergelijking tussen Site in a Box, zelf een website bouwen en een webbureau inschakelen.</caption>
            <colgroup>
              <col class="w-1/3" />
              <col class="w-[22.222%]" />
              <col class="w-[22.222%]" />
              <col class="w-[22.222%]" />
            </colgroup>
            <thead>
              <tr class="min-h-16">
                <th class="border-b-2 border-r border-border bg-muted px-2 py-3 text-left text-[11px] font-bold uppercase leading-tight tracking-[.06em] text-muted-foreground sm:px-3 sm:text-xs md:px-5 md:py-5 md:text-sm">
                  Vergelijk
                </th>
                <th scope="col" class="relative border-b-2 border-r border-border bg-plum px-1 py-3 text-white sm:px-2 md:px-4 md:py-5">
                  <img src="/theme/images/logo/siab_logo_dark.svg" alt="Site in a Box" width="160" height="40" class="mx-auto h-6 max-w-full object-contain sm:h-8 md:h-10" />
                  <span class="absolute right-0.5 top-0.5 border border-black bg-yellow px-1 py-0.5 font-head text-[7px] font-bold leading-none tracking-wide text-black sm:right-1 sm:top-1 sm:text-[8px] md:px-1.5 md:text-[9px]">BESTE</span>
                </th>
                <th scope="col" class="border-b-2 border-r border-border bg-muted px-1 py-3 text-center text-[11px] font-bold leading-tight sm:px-2 sm:text-xs md:px-4 md:py-5 md:text-base">
                  Zelf bouwen
                </th>
                <th scope="col" class="border-b-2 border-border bg-muted px-1 py-3 text-center text-[11px] font-bold leading-tight sm:px-2 sm:text-xs md:px-4 md:py-5 md:text-base">
                  Webbureau
                </th>
              </tr>
            </thead>
            <tbody>
              {comparisonRows.map((row) => (
                <tr class="border-b border-border/50 last:border-b-0">
                  <th scope="row" class="border-r border-border bg-card px-2 py-3 text-left text-[11px] font-bold leading-[1.3] sm:px-3 sm:text-xs md:px-5 md:py-4 md:text-sm lg:text-base">
                    <span class="flex items-center gap-2 md:gap-3">
                      <svg class="hidden size-7 shrink-0 text-muted-foreground sm:block md:size-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        {row.iconPaths.map((path) => <path d={path}></path>)}
                      </svg>
                      {row.label}
                    </span>
                  </th>
                  <td class="break-words border-r border-border bg-yellow/10 px-1 py-3 text-center text-[11px] font-bold leading-[1.3] text-foreground dark:bg-yellow/[.08] sm:px-2 sm:text-xs md:px-4 md:py-4 md:text-sm lg:text-base">
                    {row.siteInABox}
                  </td>
                  <td class="break-words border-r border-border px-1 py-3 text-center text-[11px] font-medium leading-[1.3] text-muted-foreground sm:px-2 sm:text-xs md:px-4 md:py-4 md:text-sm lg:text-base">
                    {row.selfBuild}
                  </td>
                  <td class="break-words px-1 py-3 text-center text-[11px] font-medium leading-[1.3] text-muted-foreground sm:px-2 sm:text-xs md:px-4 md:py-4 md:text-sm lg:text-base">
                    {row.agency}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </Card>
      </div>
    </section>

    <FaqSection />
  </main>
  <Footer />
</BaseLayout>
