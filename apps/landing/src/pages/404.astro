---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found" description="The page you were looking for doesn't exist." noindex>
  <main class="prose mx-auto max-w-3xl px-4 py-24 text-center dark:prose-invert" data-analytics-section="not_found" data-analytics-position="1">
    <h1>404 — Page not found</h1>
    <p>The page you were looking for doesn't exist.</p>
    <p><a href="/" data-analytics-action="return_home" data-analytics-placement="not_found" data-analytics-destination="home">Back to home</a></p>
  </main>
</BaseLayout>
