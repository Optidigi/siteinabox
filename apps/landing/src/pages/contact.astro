---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/siab/Header.astro';
import Footer from '../components/siab/Footer.astro';
import ContactForm from '../components/forms/ContactForm.astro';
import FaqSection from '../components/siab/FaqSection.astro';
import { Card } from '../components/ui/card';
import { site } from '../content/site';

const contacts = [
  { label: 'E-mail', value: 'info@siteinabox.nl', href: 'mailto:info@siteinabox.nl', destination: 'email', action: 'contact_email', color: 'text-cyan', paths: ['M3 7a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z', 'm3 7 9 6 9-6'] },
  { label: 'WhatsApp', value: '+31 6 25052591', href: site.links.whatsapp, destination: 'whatsapp', action: 'contact_whatsapp', color: 'text-green', paths: ['M3 21l1.65-3.8a9 9 0 1 1 3.4 2.9z', 'M9 10v-1a.5.5 0 0 1 1 0v1a5 5 0 0 0 5 5'] },
  { label: 'Telefoon', value: '+31 6 25052591', href: site.links.phone, destination: 'phone', action: 'contact_phone', color: 'text-orange', paths: ['M22 16.92v3a2 2 0 0 1-2.18 2 19.8 19.8 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.8 19.8 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.12.95.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.86.58 2.81.7A2 2 0 0 1 22 16.92z'] },
];
---

<BaseLayout title="Contact" description="Stuur Site in a Box een bericht. We lezen elk bericht en komen zo snel mogelijk bij je terug." pageType="ContactPage" hasFaq>
  <Header />
  <main class="pt-36 md:pt-[180px]">
    <section aria-labelledby="contact-heading" data-analytics-section="contact_intro" data-analytics-position="1">
      <div class="site-container text-center">
        <h1 id="contact-heading" class="text-[40px] leading-[1.2]">Stuur ons een bericht.</h1>
        <p class="mx-auto mt-9 max-w-2xl text-lg leading-relaxed text-muted-foreground">Een vraag, een idee, of gewoon even sparren? We lezen elk berichtje.</p>
        <ul class="mt-8 flex flex-wrap justify-center gap-x-8 gap-y-3 font-semibold" aria-label="Onze beloftes">
          <li class="flex items-center gap-2"><span class="grid size-6 place-items-center rounded-full border-2 border-black bg-yellow text-sm text-black">✓</span>Online binnen 3 werkdagen</li>
          <li class="flex items-center gap-2"><span class="grid size-6 place-items-center rounded-full border-2 border-black bg-yellow text-sm text-black">✓</span>Geen verrassingen</li>
          <li class="flex items-center gap-2"><span class="grid size-6 place-items-center rounded-full border-2 border-black bg-yellow text-sm text-black">✓</span>Alleen betalen als je tevreden bent</li>
        </ul>
      </div>
    </section>

    <section class="py-16 md:pb-0 md:pt-[52px]" aria-label="Contactformulier en directe contactgegevens" data-analytics-section="contact_options" data-analytics-position="2">
      <div class="site-container grid items-stretch gap-8 lg:grid-cols-[7fr_5fr] lg:gap-12">
        <ContactForm />
        <Card as="aside" className="flex flex-col p-7 shadow-md md:p-10 lg:min-h-[958px]" aria-label="Direct contact en bereikbaarheid">
          <p class="mb-5 font-head text-sm font-bold uppercase tracking-[.16em] text-muted-foreground">Direct contact</p>
          <div class="grid gap-1">
            {contacts.map((contact) => (
              <a href={contact.href} class="flex min-h-14 items-center gap-4 py-2 font-medium hover:underline hover:underline-offset-4" data-analytics-component={`cta-${contact.action}-contact-page`} data-analytics-component-type="cta" data-analytics-component-role="contact" data-analytics-action={contact.action} data-analytics-placement="contact_page" data-analytics-destination={contact.destination}>
                <svg class:list={['size-6 shrink-0', contact.color]} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">{contact.paths.map((path) => <path d={path}></path>)}</svg>
                <span class="sr-only">{contact.label}: </span><span>{contact.value}</span>
              </a>
            ))}
          </div>
          <div class="mt-8 border-t border-border/20 pt-7">
            <p class="font-head text-sm font-bold uppercase tracking-[.16em] text-muted-foreground">Bereikbaarheid</p>
            <p class="mt-3 font-semibold">Ma–Vr · 09:00–17:00</p>
          </div>
          {site.socials.instagram && (
            <div class="mt-auto border-t border-border/20 pt-7">
              <p class="mb-3 font-head text-sm font-bold uppercase tracking-[.16em] text-muted-foreground">Volg ons</p>
              <a class="font-bold underline decoration-dashed underline-offset-4" href={site.socials.instagram} rel="noopener" target="_blank" data-analytics-action="open_instagram" data-analytics-placement="contact_page" data-analytics-destination="social">Instagram</a>
            </div>
          )}
        </Card>
      </div>
    </section>
    <FaqSection />
  </main>
  <Footer />
</BaseLayout>
