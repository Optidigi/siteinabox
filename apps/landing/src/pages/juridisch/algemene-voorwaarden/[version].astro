---
import type { InferGetStaticPropsType } from 'astro';
import LegalDocumentPage from '../../../components/legal/LegalDocumentPage.astro';
import { getLegalReleases } from '../../../lib/legal';

export function getStaticPaths() {
  return getLegalReleases({ documentType: 'platform-terms', locale: 'nl' }).map((document) => ({
    params: { version: document.documentVersion },
    props: { document },
  }));
}

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { document } = Astro.props;
---

<LegalDocumentPage document={document} />
