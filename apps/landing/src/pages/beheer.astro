---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/siab/Header.astro';
import Footer from '../components/siab/Footer.astro';
import FaqSection from '../components/siab/FaqSection.astro';
import { Button } from '../components/ui/button';
import { Card } from '../components/ui/card';
import { Input } from '../components/ui/input';
import { Label } from '../components/ui/label';
import { site } from '../content/site';
---

<BaseLayout title="Beheer login" description="Log in op de beheeromgeving van je Site in a Box website." noindex>
  <Header />
  <main class="pt-36 md:pt-[180px]">
    <section class="pb-16 md:pb-24" aria-labelledby="beheer-heading" data-analytics-section="beheer_login" data-analytics-position="1">
      <div class="site-container grid items-center gap-12 lg:grid-cols-2">
        <div>
          <h1 id="beheer-heading" class="text-[40px] leading-[1.2]">Log in op je beheeromgeving.</h1>
          <p class="mt-7 max-w-xl text-lg leading-relaxed text-muted-foreground">Vul het domein van je website in. We sturen je naar de juiste beheeromgeving, bijvoorbeeld admin.jouwdomein.nl.</p>
        </div>
        <Card className="p-7 shadow-[6px_6px_0_#090709] md:p-12">
        <section aria-label="Login domein kiezen">
          <p class="font-head text-sm font-bold uppercase tracking-[.16em] text-muted-foreground">Beheer login</p>
          <h2 class="mb-7 mt-2 text-4xl md:text-[56px]">Waar staat je website?</h2>
          <form id="tenant-login-form" novalidate data-analytics-component="beheer-domain-form" data-analytics-component-type="form" data-analytics-component-role="login">
            <Label className="mb-2 block font-bold" htmlFor="tenant-domain">Website domein</Label>
            <div class="grid gap-4 sm:grid-cols-[1fr_auto]">
              <Input className="min-h-14 px-4 text-base" id="tenant-domain" name="domain" type="text" inputMode="url" autoComplete="url" placeholder="jouwdomein.nl" aria-describedby="tenant-domain-help tenant-domain-error" required />
              <Button type="submit" size="lg" className="min-h-14" data-analytics-action="submit_beheer_domain" data-analytics-placement="beheer" data-analytics-destination="tenant_admin">Inloggen</Button>
            </div>
            <p id="tenant-domain-help" class="mt-3 text-sm leading-relaxed text-muted-foreground">Gebruik het domein van je website. Als je admin.jouwdomein.nl invult, gebruiken we die direct.</p>
            <p id="tenant-domain-error" class="mt-3 font-bold text-destructive" role="alert" hidden>Vul een geldig domein in, bijvoorbeeld ami-care.nl.</p>
          </form>
          <div class="mt-8 flex flex-wrap gap-2 border-t border-border/20 pt-6 text-sm text-muted-foreground">
            <span>Site in a Box beheerder?</span>
            <a class="font-bold text-foreground underline underline-offset-4" href={site.links.platformAdminLogin} data-analytics-action="open_platform_login" data-analytics-placement="beheer" data-analytics-destination="platform_admin">Open platform login</a>
          </div>
        </section>
        </Card>
      </div>
    </section>
    <FaqSection />
  </main>
  <Footer />

  <script>
    import { captureLandingEvent } from '../lib/landing-analytics';

    const form = document.querySelector<HTMLFormElement>('#tenant-login-form');
    const input = document.querySelector<HTMLInputElement>('#tenant-domain');
    const error = document.querySelector<HTMLElement>('#tenant-domain-error');
    let formStarted = false;

    const normalizeDomain = (value: string) => {
      let normalized = value.trim().toLowerCase();
      normalized = normalized.replace(/^https?:\/\//, '').replace(/^\/+/, '');
      normalized = normalized.split('/')[0].split('?')[0].split('#')[0];
      return normalized.replace(/:\d+$/, '').replace(/^www\./, '');
    };
    const isValidDomain = (domain: string) =>
      /^(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\.)+[a-z]{2,63}$/.test(domain);

    form?.addEventListener('focusin', () => {
      if (formStarted) return;
      formStarted = true;
      captureLandingEvent('site_form_started', {
        form_id: 'beheer_domain',
        form_type: 'beheer_login',
        form_state: 'started',
      });
    });

    form?.addEventListener('submit', (event) => {
      event.preventDefault();
      if (!input || !error) return;
      error.hidden = true;
      const domain = normalizeDomain(input.value);
      const host = domain.startsWith('admin.') ? domain : `admin.${domain}`;
      if (!isValidDomain(domain) || !isValidDomain(host)) {
        error.hidden = false;
        input.setAttribute('aria-invalid', 'true');
        input.focus();
        captureLandingEvent('site_journey_step', {
          journey_name: 'beheer_login',
          journey_step: 'validation_blocked',
          form_id: 'beheer_domain',
          form_type: 'beheer_login',
          form_state: 'invalid',
          error_category: 'invalid_domain',
        });
        return;
      }
      input.removeAttribute('aria-invalid');
      captureLandingEvent('site_form_submitted', {
        form_id: 'beheer_domain',
        form_type: 'beheer_login',
        form_state: 'redirecting',
      });
      captureLandingEvent('site_journey_step', {
        journey_name: 'beheer_login',
        journey_step: 'tenant_admin_redirect',
        form_id: 'beheer_domain',
        form_type: 'beheer_login',
        form_state: 'redirecting',
        destination_type: 'tenant_admin',
      });
      window.location.assign(`https://${host}/login`);
    });
  </script>
</BaseLayout>
