---
import Footer from '../siab/Footer.astro';
import Header from '../siab/Header.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';

type LegalDocument = {
  title: string;
  documentVersion: string;
  effectiveAt: string;
  contentHash: string;
  stablePath: string;
  permanentPath: string;
  html: string;
};

interface Props {
  document: LegalDocument;
  isCurrentAlias?: boolean;
}

const { document, isCurrentAlias = false } = Astro.props;
const effectiveDate = new Intl.DateTimeFormat('nl-NL', {
  dateStyle: 'long',
  timeZone: 'Europe/Amsterdam',
}).format(new Date(document.effectiveAt));
const canonicalPath = isCurrentAlias ? document.stablePath : document.permanentPath;
---

<BaseLayout
  title={document.title}
  description={`${document.title}, versie ${document.documentVersion}, geldig vanaf ${effectiveDate}.`}
  canonical={new URL(canonicalPath, Astro.site).toString()}
>
  <Header />
  <main class="pb-20 pt-36 md:pb-28 md:pt-48" data-analytics-section="legal_document" data-analytics-position="1">
    <div class="mx-auto w-[min(100%-2rem,58rem)]">
      <div class="mb-7 flex flex-wrap gap-2 border-b-2 border-border pb-5 text-sm font-semibold text-muted-foreground" aria-label="Documentgegevens">
        <span>Versie {document.documentVersion}</span>
        <span aria-hidden="true">&middot;</span>
        <span>Geldig vanaf {effectiveDate}</span>
        {!isCurrentAlias && (
          <>
            <span aria-hidden="true">&middot;</span>
            <a class="underline underline-offset-4" href={document.stablePath} data-analytics-action="view_current_legal_version" data-analytics-placement="legal_document" data-analytics-destination="legal">Bekijk de huidige versie</a>
          </>
        )}
      </div>
      <article class="legal-copy" set:html={document.html} />
      <footer class="mt-16 border-t-2 border-border pt-5 text-xs text-muted-foreground">
        <p class="mb-2">Document-ID: {document.documentVersion}</p>
        <p class="mb-2 break-all">SHA-256: <code>{document.contentHash.replace('sha256:', '')}</code></p>
        {isCurrentAlias && <a class="font-bold underline underline-offset-4" href={document.permanentPath} data-analytics-action="view_permanent_legal_version" data-analytics-placement="legal_document" data-analytics-destination="legal">Permanente link naar deze versie</a>}
      </footer>
    </div>
  </main>
  <Footer />
</BaseLayout>
