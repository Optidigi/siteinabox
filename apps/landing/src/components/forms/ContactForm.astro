---
import { site } from '../../content/site';
import { Button } from '../ui/button';
import { Card } from '../ui/card';
import { Checkbox } from '../ui/checkbox';
import { Field } from '../ui/field';
import { Input } from '../ui/input';
import { Label } from '../ui/label';
import { NativeSelect } from '../ui/select';
import { Textarea } from '../ui/textarea';
import Turnstile from './Turnstile.astro';
---

<Card className="h-full p-6 shadow-md md:p-10 lg:min-h-[958px]">
<section aria-label="Contactformulier" data-analytics-section="contact_form" data-analytics-position="3">
  <form action="/api/contact" method="POST" novalidate data-siab-form aria-describedby="siab-form-required-hint">
    <p id="siab-form-required-hint" class="sr-only">Velden met een sterretje zijn verplicht.</p>
    <input type="hidden" name="source" value={`${site.primaryDomain}/contact`} />
    <div class="mb-6 border-2 border-destructive bg-destructive/10 p-4 font-bold text-destructive" role="alert" hidden data-siab-summary>
      Er ging iets mis. Controleer de gemarkeerde velden hieronder.
    </div>

    <Field className="mb-6" data-siab-field data-analytics-field="name">
      <Label className="mb-2 block font-bold" htmlFor="siab-name">Naam <span aria-hidden="true">*</span></Label>
      <Input className="min-h-14 px-4 text-base" id="siab-name" name="name" type="text" autoComplete="name" required aria-required="true" aria-describedby="siab-name-err" />
      <p id="siab-name-err" class="mt-2 hidden text-sm font-semibold text-destructive" data-siab-error data-empty="Vul je naam in zodat we weten met wie we praten."></p>
    </Field>

    <Field className="mb-6" data-siab-field data-analytics-field="email">
      <Label className="mb-2 block font-bold" htmlFor="siab-email">E-mailadres <span aria-hidden="true">*</span></Label>
      <Input className="min-h-14 px-4 text-base" id="siab-email" name="email" type="email" autoComplete="email" required aria-required="true" aria-describedby="siab-email-err" />
      <p id="siab-email-err" class="mt-2 hidden text-sm font-semibold text-destructive" data-siab-error data-empty="Vul je e-mailadres in zodat we kunnen antwoorden." data-invalid="Dit lijkt geen geldig e-mailadres. Controleer 'm even."></p>
    </Field>

    <Field className="mb-6" data-siab-field data-analytics-field="phone">
      <Label className="mb-2 block font-bold" htmlFor="siab-phone">Telefoon <span class="ml-2 font-body text-sm font-normal text-muted-foreground">(optioneel)</span></Label>
      <Input className="min-h-14 px-4 text-base" id="siab-phone" name="phone" type="tel" autoComplete="tel" inputMode="tel" aria-describedby="siab-phone-help" />
      <p id="siab-phone-help" class="mt-2 text-sm text-muted-foreground">We bellen alleen als dat sneller helpt dan een mail.</p>
    </Field>

    <Field className="mb-6" data-siab-field data-analytics-field="subject">
      <Label className="mb-2 block font-bold" htmlFor="siab-subject">Onderwerp <span class="ml-2 font-body text-sm font-normal text-muted-foreground">(optioneel)</span></Label>
      <NativeSelect id="siab-subject" name="subject_topic" aria-describedby="siab-subject-help">
        <option value="" disabled selected>Kies een onderwerp (optioneel)</option>
        <option value="kennismaking">Vrijblijvend kennismaken</option>
        <option value="pakket">Vraag over een pakket</option>
        <option value="overig">Iets anders</option>
      </NativeSelect>
      <p id="siab-subject-help" class="mt-2 text-sm text-muted-foreground">Helpt ons je vraag bij de juiste persoon te leggen.</p>
    </Field>

    <Field className="mb-6" data-siab-field data-analytics-field="message">
      <Label className="mb-2 block font-bold" htmlFor="siab-message">Bericht <span aria-hidden="true">*</span></Label>
      <Textarea className="min-h-40 resize-y p-4 text-base" id="siab-message" name="message" rows={6} required aria-required="true" aria-describedby="siab-message-err" />
      <p id="siab-message-err" class="mt-2 hidden text-sm font-semibold text-destructive" data-siab-error data-empty="Schrijf even kort waar je bericht over gaat."></p>
    </Field>

    <Field className="mb-7" data-siab-field data-analytics-field="consent">
      <Label className="flex cursor-pointer items-start gap-3 font-body leading-relaxed" htmlFor="siab-consent">
        <Checkbox className="mt-1" id="siab-consent" name="consent" required aria-required="true" aria-describedby="siab-consent-err" />
        <span>Ik ga akkoord dat Site in a Box mijn bericht en e-mailadres gebruikt om mij te antwoorden. <a class="font-bold underline decoration-dashed underline-offset-4" href="/privacy-en-cookieverklaring">Zie onze privacy- en cookieverklaring</a>.</span>
      </Label>
      <p id="siab-consent-err" class="mt-2 hidden text-sm font-semibold text-destructive" data-siab-error data-empty="Vink dit aan om je bericht te kunnen versturen."></p>
    </Field>

    <Turnstile />
    <div class="flex flex-wrap items-center gap-5">
      <Button type="submit" size="lg" className="min-h-14 min-w-56" data-siab-submit>Verstuur bericht</Button>
      <p class="text-sm font-semibold text-muted-foreground">We reageren binnen 1 werkdag.</p>
    </div>
  </form>

  <div role="status" aria-live="polite" tabindex="-1" hidden data-siab-success>
    <h2 class="text-4xl">Bedankt voor je bericht.</h2>
    <p class="mt-4 text-lg leading-relaxed text-muted-foreground">We hebben je bericht ontvangen en komen er zo snel mogelijk op terug. Hou je e-mail in de gaten.</p>
  </div>
</section>
</Card>

<script>
  import { captureLandingEvent } from '../../lib/landing-analytics';

  document.addEventListener('DOMContentLoaded', () => {
    const form = document.querySelector<HTMLFormElement>('[data-siab-form]');
    if (!form) return;
    const summary = form.querySelector<HTMLElement>('[data-siab-summary]');
    const success = document.querySelector<HTMLElement>('[data-siab-success]');
    const fields = Array.from(form.querySelectorAll<HTMLElement>('[data-siab-field]'));
    const turnstileContainer = form.querySelector<HTMLElement>('[data-siab-turnstile]');
    const turnstileError = form.querySelector<HTMLElement>('[data-siab-turnstile-error]');
    const turnstileWindow = window as typeof window & {
      turnstile?: { reset: () => void };
    };
    let formStarted = false;

    const captureFormJourney = (journeyStep: string, properties: Record<string, string | number | boolean | null> = {}) => {
      captureLandingEvent('site_journey_step', {
        journey_name: 'contact_form',
        journey_step: journeyStep,
        form_id: 'platform_contact',
        form_type: 'contact',
        ...properties,
      });
    };

    form.addEventListener('focusin', () => {
      if (formStarted) return;
      formStarted = true;
      captureLandingEvent('site_form_started', {
        form_id: 'platform_contact',
        form_type: 'contact',
        form_state: 'started',
      });
    });

    const resetTurnstile = () => turnstileWindow.turnstile?.reset();

    const showTurnstileError = (message?: string) => {
      if (turnstileError) {
        if (message) turnstileError.textContent = message;
        turnstileError.classList.remove('hidden');
      }
      turnstileContainer?.focus();
    };

    const clearTurnstileError = () => turnstileError?.classList.add('hidden');

    const setInvalid = (field: HTMLElement, key: 'empty' | 'invalid') => {
      const error = field.querySelector<HTMLElement>('[data-siab-error]');
      if (error) {
        error.textContent = error.dataset[key] ?? error.dataset.empty ?? '';
        error.classList.remove('hidden');
      }
      field.querySelector<HTMLElement>('input, textarea, select')?.setAttribute('aria-invalid', 'true');
    };
    const clearInvalid = (field: HTMLElement) => {
      field.querySelector<HTMLElement>('[data-siab-error]')?.classList.add('hidden');
      field.querySelector<HTMLElement>('input, textarea, select')?.removeAttribute('aria-invalid');
    };
    const validate = (field: HTMLElement) => {
      const input = field.querySelector<HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement>('input, textarea, select');
      if (!input) return true;
      if (input instanceof HTMLInputElement && input.type === 'checkbox') {
        if (input.required && !input.checked) { setInvalid(field, 'empty'); return false; }
      } else if (input.required && input.value.trim() === '') {
        setInvalid(field, 'empty'); return false;
      } else if (input instanceof HTMLInputElement && input.type === 'email' && input.value && !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(input.value.trim())) {
        setInvalid(field, 'invalid'); return false;
      }
      clearInvalid(field);
      return true;
    };

    fields.forEach((field) => {
      const control = field.querySelector<HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement>('input, textarea, select');
      control?.addEventListener('blur', () => validate(field));
      control?.addEventListener('input', () => validate(field));
      control?.addEventListener('change', () => validate(field));
    });

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      let firstInvalid: HTMLElement | null = null;
      for (const field of fields) if (!validate(field) && !firstInvalid) firstInvalid = field;
      if (firstInvalid) {
        if (summary) summary.hidden = false;
        captureFormJourney('validation_blocked', {
          error_category: `field_${firstInvalid.dataset.analyticsField ?? 'unknown'}`,
          form_state: 'invalid',
        });
        firstInvalid.querySelector<HTMLElement>('input, textarea, select')?.focus();
        return;
      }
      if (summary) summary.hidden = true;
      const turnstileToken = form.querySelector<HTMLInputElement>('[name="cf-turnstile-response"]')?.value.trim();
      if (!turnstileToken) {
        captureFormJourney('validation_blocked', {
          error_category: 'turnstile_missing',
          form_state: 'invalid',
        });
        showTurnstileError();
        return;
      }
      clearTurnstileError();
      captureLandingEvent('site_form_submitted', {
        form_id: 'platform_contact',
        form_type: 'contact',
        form_state: 'submit_attempted',
      });
      const button = form.querySelector<HTMLButtonElement>('[data-siab-submit]');
      if (button) { button.disabled = true; button.textContent = 'Versturen…'; }
      let failureCategory = 'network_or_server';
      try {
        const response = await fetch(form.action, { method: 'POST', body: new FormData(form) });
        if (!response.ok) {
          const responseBody: unknown = await response.json().catch(() => null);
          const responseCode = responseBody
            && typeof responseBody === 'object'
            && 'code' in responseBody
            && typeof responseBody.code === 'string'
              ? responseBody.code
              : '';
          if (responseCode.startsWith('turnstile_')) {
            failureCategory = response.status === 503 ? 'turnstile_unavailable' : 'turnstile_rejected';
            showTurnstileError(
              response.status === 503
                ? 'De beveiligingscontrole is tijdelijk niet beschikbaar. Probeer het zo opnieuw.'
                : 'De beveiligingscontrole is verlopen. Bevestig opnieuw dat je geen robot bent.',
            );
          }
          else if (responseCode === 'rate_limited') failureCategory = 'rate_limited';
          else if (responseCode === 'invalid_request') failureCategory = 'invalid_request';
          else failureCategory = 'server_rejected';
          throw new Error('submit-failed');
        }
        form.hidden = true;
        if (success) { success.hidden = false; success.focus(); }
        captureLandingEvent('site_conversion_completed', {
          form_id: 'platform_contact',
          form_type: 'contact',
          form_state: 'accepted',
          conversion_source: 'contact_form',
        });
      } catch {
        captureFormJourney('submit_failed', {
          error_category: failureCategory,
          form_state: 'failed',
        });
        resetTurnstile();
        if (summary && turnstileError?.classList.contains('hidden') !== false) {
          summary.hidden = false;
          summary.textContent = 'Versturen lukte niet. Probeer het zo opnieuw, of stuur een mail naar info@siteinabox.nl.';
        }
        if (button) { button.disabled = false; button.textContent = 'Verstuur bericht'; }
      }
    });
  });
</script>
