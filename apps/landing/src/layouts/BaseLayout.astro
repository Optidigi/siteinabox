---
import '../styles/global.css';
import Seo from '../components/seo/Seo.astro';
import JsonLdGraph from '../components/seo/JsonLdGraph.astro';
import { Button } from '../components/ui/button';
import { site } from '../content/site';
import { matchesApprovedPublicAnalyticsConsent, publicAnalyticsConsentApproval } from '@siteinabox/legal-content/consent-approval';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  noindex?: boolean;
  canonical?: string;
  pageType?: 'WebPage' | 'ContactPage';
  hasFaq?: boolean;
}

const { title, description, ogImage, noindex, canonical, pageType = 'WebPage', hasFaq = false } = Astro.props;
const consentVersion = publicAnalyticsConsentApproval.platformLandingConsentVersion;
const consent = {
  enabled: true,
  provider: 'posthog',
  consentStorageKey: 'siab_platform_analytics_consent',
  consentVersion,
};
const posthogProjectToken = process.env.POSTHOG_PROJECT_TOKEN?.trim();
const analyticsConfig = posthogProjectToken && matchesApprovedPublicAnalyticsConsent(consent, consentVersion)
  ? {
      projectToken: posthogProjectToken,
      apiHost: (process.env.POSTHOG_PUBLIC_HOST || 'https://r.siteinabox.nl').replace(/\/+$/, ''),
      uiHost: (process.env.POSTHOG_HOST || 'https://eu.posthog.com').replace(/\/+$/, ''),
      consentStorageKey: consent.consentStorageKey,
      consentVersion,
      siteDomain: site.primaryDomain,
      googleAnalyticsMeasurementId: 'G-EM6YQ9893X',
    }
  : null;
---

<!doctype html>
<html lang={site.language}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      (function () {
        var resolved;
        try {
          var saved = localStorage.getItem('siab-theme');
          if (saved === 'light' || saved === 'dark') resolved = saved;
        } catch {}
        if (!resolved) {
          resolved = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches
            ? 'dark'
            : 'light';
        }
        document.documentElement.setAttribute('data-theme', resolved);
      })();
    </script>
    <meta name="theme-color" content="#fef3f4" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#3a1a30" media="(prefers-color-scheme: dark)" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="64x64" href="/favicon.png" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.json" />
    <meta name="generator" content={Astro.generator} />
    <Seo title={title} description={description} ogImage={ogImage} noindex={noindex} canonical={canonical} />
    <JsonLdGraph title={title} description={description} noindex={noindex} pageType={pageType} hasFaq={hasFaq} />
    <link rel="preload" href="/theme/lottie/rocket-siab.json" as="fetch" crossorigin />
  </head>
  <body>
    {analyticsConfig && (
      <script
        id="siab-analytics-config"
        type="application/json"
        set:html={JSON.stringify(analyticsConfig).replace(/</g, '\\u003c')}
      />
    )}
    <div class="min-h-screen overflow-x-clip bg-background text-foreground">
      <slot />
    </div>

    {analyticsConfig && (
      <aside
        class="siab-cookie-consent"
        data-siab-cookie-consent="true"
        aria-labelledby="siab-cookie-consent-title"
        aria-describedby="siab-cookie-consent-description"
      >
        <div class="siab-cookie-consent__content">
          <span class="siab-cookie-consent__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 3a3 3 0 0 0 3 3 3 3 0 0 0 3 3 3 3 0 0 0 3 3 9 9 0 1 1-9-9Z" />
              <path d="M8 8h.01M8 14h.01M14 14h.01M14 18h.01" />
            </svg>
          </span>
          <div>
            <strong id="siab-cookie-consent-title">Cookies en privacy</strong>
            <p id="siab-cookie-consent-description">
              Wij en onze partners gebruiken cookies en vergelijkbare technologieën om je ervaring te verbeteren en te analyseren hoe onze website wordt gebruikt.
              <a href="/privacy-en-cookieverklaring">Lees ons cookiebeleid</a>.
            </p>
          </div>
        </div>
        <div class="siab-cookie-consent__actions">
          <Button className="siab-cookie-consent__reject" variant="ghost" type="button" data-consent-action="reject">Weigeren</Button>
          <Button className="siab-cookie-consent__accept" type="button" data-consent-action="accept">Accepteren</Button>
        </div>
      </aside>
    )}

    <script>
      import '../scripts/analytics';
      import lottie from 'lottie-web/build/player/lottie_light.min.js';

      const rocket = document.getElementById('hero-rocket');
      if (rocket) {
        const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        lottie.loadAnimation({
          container: rocket,
          renderer: 'svg',
          loop: !reduce,
          autoplay: !reduce,
          path: '/theme/lottie/rocket-siab.json',
        });
      }
    </script>
  </body>
</html>
