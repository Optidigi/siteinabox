---
import { renderToStaticMarkup } from "react-dom/server"
import {
  SitePageRenderer,
  LegalDocumentPage,
  buildPageSeoMetadata,
  COLOR_MODE_BOOTSTRAP_SCRIPT,
  createRendererMediaResolver,
  themeMode,
  themePreference,
} from "@siteinabox/site-renderer"
import type { SiteSettings } from "@siteinabox/contracts"
import "../styles/site.css"
import { findPublishedPage, loadPublishedSnapshot, pagePath } from "../lib/snapshot"
import { analyticsConfigJson, buildAnalyticsConfig } from "../lib/analytics-config.js"
import { publicHostFromProtectedRequest } from "../lib/origin-protection"

const pathname = `/${Astro.params.path ?? ""}`
const host = publicHostFromProtectedRequest(Astro.request)

const snapshot = await loadPublishedSnapshot(host)
const page = snapshot ? findPublishedPage(snapshot, pathname) : null
const resolved = snapshot && page
  ? {
      snapshot,
      page,
      pathname: pagePath(page),
  }
  : null
const privacyPath = pathname.replace(/\/+$/, "") || "/"
const legalDocument = snapshot && privacyPath === "/privacy-en-cookieverklaring"
  ? snapshot.settings.privacyDisclosure?.enabled
    ? snapshot.settings.privacyDisclosure
    : null
  : null
const displayable = Boolean(resolved || legalDocument)

if (!displayable) {
  Astro.response.status = 404
}

const seo = resolved
  ? buildPageSeoMetadata({
      page: resolved.page,
      settings: resolved.snapshot.settings,
      mediaResolver: createRendererMediaResolver(resolved.snapshot.tenantId),
    })
  : legalDocument
    ? {
        title: legalDocument.title?.trim() || "Privacy- en cookieverklaring",
        description: `Lees hoe ${snapshot?.settings.siteName ?? "deze website"} persoonsgegevens en websitegegevens verwerkt.`,
      }
    : null
const mediaResolver = snapshot ? createRendererMediaResolver(snapshot.tenantId) : undefined
const analyticsConfig = resolved
  ? buildAnalyticsConfig({ snapshot: resolved.snapshot, page: resolved.page, pathname: resolved.pathname })
  : null
const analyticsConfigContent = analyticsConfigJson(analyticsConfig)
const escapeHtml = (value: string): string => value
  .replaceAll("&", "&amp;")
  .replaceAll("<", "&lt;")
  .replaceAll(">", "&gt;")
  .replaceAll('"', "&quot;")
  .replaceAll("'", "&#39;")
const systemPageHtml = (kind: "not-found" | "maintenance", settings: SiteSettings): string => {
  const maintenance = kind === "maintenance"
  const heading = maintenance
    ? "We are making a few improvements"
    : settings.systemTemplates?.notFound?.heading ?? "Page not found"
  const body = maintenance
    ? settings.maintenance?.message ?? "Please check back shortly."
    : settings.systemTemplates?.notFound?.body ?? "The page you requested could not be found."
  const action = !maintenance && settings.systemTemplates?.notFound?.primaryAction?.href
    ? `<a href="${escapeHtml(settings.systemTemplates.notFound.primaryAction.href)}">${escapeHtml(settings.systemTemplates.notFound.primaryAction.label ?? "Back to the homepage")}</a>`
    : ""
  return `<main data-siab-system-page="${kind}" style="min-height:100vh;display:grid;place-items:center;padding:3rem 1.5rem;text-align:center"><div><h1>${escapeHtml(heading)}</h1><p>${escapeHtml(body)}</p>${action}</div></main>`
}
const rendererHtml = resolved
  ? snapshot?.settings.maintenance?.enabled
    ? systemPageHtml("maintenance", resolved.snapshot.settings)
    : renderToStaticMarkup(
      SitePageRenderer({
        page: resolved.page,
        settings: resolved.snapshot.settings,
        theme: resolved.snapshot.theme,
        tenantSlug: resolved.snapshot.tenantSlug,
        domain: resolved.snapshot.domain,
        mediaResolver,
        consentAvailable: Boolean(analyticsConfig?.enabled),
        imageLoading: import.meta.env.SIAB_RENDERER_FIXTURE_MODE === "1" ? "eager" : undefined,
      }),
    )
  : legalDocument
    ? renderToStaticMarkup(
      LegalDocumentPage({
        document: legalDocument,
        theme: snapshot?.theme,
      }),
    )
  : snapshot
    ? systemPageHtml("not-found", snapshot.settings)
  : ""
const mediaHref = (value: unknown): string | null => {
  if (!value || !mediaResolver) return null
  const resolvedMedia = mediaResolver(value)
  if (!resolvedMedia) return null
  if (typeof resolvedMedia === "string") return resolvedMedia
  if (resolvedMedia.src) return resolvedMedia.src
  return null
}
const faviconHref =
  snapshot
    ? mediaHref(snapshot.settings.branding?.favicon)
    : null
const configuredThemeMode = themePreference(snapshot?.theme)
const initialColorMode = themeMode(snapshot?.theme)
---

<!doctype html>
{
  displayable && seo && snapshot ? (
    <html lang={snapshot.settings.language} data-renderer-schema={snapshot.schemaVersion} data-siab-theme-mode={configuredThemeMode} data-siab-color-mode={initialColorMode} data-rt-mode={initialColorMode}>
      <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="color-scheme" content="light dark" />
        <script is:inline set:html={COLOR_MODE_BOOTSTRAP_SCRIPT} />
        <meta name="generator" content={Astro.generator} />
        <style is:global>
          html,
          body {
            margin: 0;
            min-width: 320px;
          }
        </style>
        {faviconHref && <link rel="icon" href={faviconHref} />}
        <title>{seo.title}</title>
        {seo.description && <meta name="description" content={seo.description} />}
        {seo.canonical && <link rel="canonical" href={seo.canonical} />}
        <meta property="og:site_name" content={snapshot.settings.siteName} />
        <meta property="og:type" content="website" />
        <meta property="og:title" content={seo.openGraph?.title ?? seo.title} />
        {seo.openGraph?.description && <meta property="og:description" content={seo.openGraph.description} />}
        {seo.openGraph?.url && <meta property="og:url" content={seo.openGraph.url} />}
        {resolved && seo.openGraph?.images?.map((image) => (
          <>
            <meta property="og:image" content={image.url} />
            {image.alt && <meta property="og:image:alt" content={image.alt} />}
          </>
        ))}
        <meta name="twitter:card" content={resolved && seo.openGraph?.images?.length ? "summary_large_image" : "summary"} />
      </head>
      <body data-tenant-slug={snapshot.tenantSlug}>
        {analyticsConfigContent && <script is:inline id="siab-analytics-config" type="application/json" set:html={analyticsConfigContent} />}
        <div set:html={rendererHtml} />
        <script>
          import "../client/site-behavior"
        </script>
      </body>
    </html>
  ) : (
    <html lang={snapshot?.settings.language ?? "en"} data-renderer-schema={snapshot?.schemaVersion} data-siab-theme-mode={configuredThemeMode} data-siab-color-mode={initialColorMode} data-rt-mode={initialColorMode}>
      <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="color-scheme" content="light dark" />
        <script is:inline set:html={COLOR_MODE_BOOTSTRAP_SCRIPT} />
        <meta name="generator" content={Astro.generator} />
        <meta name="robots" content="noindex" />
        <style is:global>
          html,
          body {
            margin: 0;
            min-width: 320px;
          }
        </style>
        <title></title>
      </head>
      <body data-tenant-slug={snapshot?.tenantSlug}></body>
    </html>
  )
}
