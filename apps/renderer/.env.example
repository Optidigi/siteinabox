# Production/staging renderer environment.
# NODE_ENV, HOST, and PORT are set by apps/renderer/compose.yml.

SIAB_CMS_URL=https://admin.siteinabox.nl
SIAB_RENDERER_API_TOKEN=<same value configured in CMS>
# High-entropy value injected into origin requests at the Cloudflare edge and
# validated (but never added) by the renderer; minimum 32 characters.
SIAB_RENDERER_ORIGIN_SECRET=<random origin verification secret>
DATA_DIR=/data-out

# Astro build/runtime fallback only. Tenant canonical URLs come from snapshots.
SITE_URL=https://renderer.example.test

# Keep empty in production.
SIAB_RENDERER_FIXTURE_MODE=
