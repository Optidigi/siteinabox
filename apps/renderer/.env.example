# Production/staging renderer environment.
# NODE_ENV, HOST, and PORT are set by apps/renderer/compose.yml.

SIAB_CMS_URL=https://admin.siteinabox.nl
# Immutable digest reported by the successful renderer image workflow.
SIAB_RENDERER_IMAGE_DIGEST=sha256:<64-hex-digest>
# Host paths to mode-0600 secret files mounted by compose. The tunnel token
# belongs to the dedicated, remotely managed Siteinabox renderer tunnel. The
# renderer trusts only that private outbound-only network path in production.
SIAB_RENDERER_API_TOKEN_FILE=/srv/saas/secrets/siteinabox-renderer-api-token
CLOUDFLARE_TUNNEL_TOKEN_FILE=/srv/saas/secrets/siteinabox-renderer-tunnel-token
DATA_DIR=/data-out

# Astro build/runtime fallback only. Tenant canonical URLs come from snapshots.
SITE_URL=https://renderer.example.test

# Keep empty in production.
SIAB_RENDERER_FIXTURE_MODE=
