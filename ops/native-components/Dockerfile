FROM golang:1.27.3-alpine@sha256:d200d2dd76b03a99b52651fd1325aff7dcd35422c35c01bac56571b0507f3deb AS build
RUN apk add --no-cache git
COPY . /native-recipes
ARG COMPONENT
RUN sh /native-recipes/build.sh "$COMPONENT"
FROM scratch
COPY --from=build /out/ /
