{
  "name": "siteinabox",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=26.0.0 <27.0.0"
  },
  "scripts": {
    "check:ci": "node scripts/run-verification.mjs ci",
    "check:fast": "node scripts/run-verification.mjs fast",
    "check:toolchain": "node --test scripts/check-toolchain.test.mjs scripts/check-required-ci.test.mjs scripts/check-verification-prerequisites.test.mjs scripts/check-publication.test.mjs scripts/verify-image.test.mjs && node scripts/check-toolchain.mjs && node scripts/run-verification.mjs --check",
    "environment:check": "node --test scripts/check-environment-contract.test.mjs && node scripts/check-environment-inventory.mjs",
    "workflow:check": "node --test scripts/workflow-path-parser.test.mjs && node scripts/check-workflow-path-matrix.mjs",
    "workflow:actions:check": "node scripts/check-workflow-actions.mjs",
    "deployment:static-parity": "node scripts/check-static-deployment-parity.mjs",
    "cms:cleanup-test-data": "node scripts/cleanup-cms-test-data.mjs",
    "cms:cleanup-test-data:test": "node --test scripts/cleanup-cms-test-data.test.mjs",
    "cms:typecheck": "pnpm --dir apps/cms typecheck",
    "cms:test": "pnpm --dir apps/cms test",
    "cms:build": "pnpm --dir apps/cms build",
    "contracts:typecheck": "pnpm --dir packages/contracts typecheck",
    "docs:check": "node scripts/check-doc-links.mjs",
    "frontend:verify": "pnpm packages:typecheck && pnpm --dir apps/cms lint:ui-boundary && pnpm --dir apps/cms lint:ui-composition && pnpm --dir apps/cms lint:no-css",
    "landing:build": "pnpm --filter siteinabox-landing build",
    "landing:test": "pnpm --filter siteinabox-landing test",
    "legal:check": "pnpm --dir packages/legal-content check",
    "mcp:check": "node --test scripts/sync-mcp-config.test.mjs && node scripts/sync-mcp-config.mjs --check",
    "mcp:sync": "node scripts/sync-mcp-config.mjs",
    "packages:typecheck": "pnpm contracts:typecheck && pnpm ui:typecheck && pnpm site-renderer:typecheck",
    "renderer:build": "pnpm --dir apps/renderer build",
    "renderer:deploy-contract": "node scripts/check-renderer-deploy-contract.mjs",
    "renderer:test": "pnpm --dir apps/renderer test",
    "renderer:typecheck": "pnpm --dir apps/renderer typecheck",
    "site-renderer:typecheck": "pnpm --dir packages/site-renderer typecheck",
    "site:build": "pnpm landing:build",
    "site:test": "pnpm landing:test",
    "type-safety:check": "node --test scripts/check-type-safety.test.mjs scripts/check-astro-type-boundaries.test.mjs scripts/check-operational-type-coverage.test.mjs && node scripts/check-type-safety.mjs",
    "type-safety:test": "node --test scripts/check-type-safety.test.mjs scripts/check-astro-type-boundaries.test.mjs scripts/check-operational-type-coverage.test.mjs",
    "ui:typecheck": "pnpm --dir packages/ui typecheck",
    "dependency:check": "node --test scripts/check-dependency-security.test.mjs && node scripts/check-dependency-security.mjs",
    "dependency:release": "node scripts/check-dependency-security.mjs --release",
    "image:verify": "node scripts/verify-image.mjs",
    "type-safety:packages": "tsc --project tsconfig.javascript.json && eslint \"packages/*/src/**/*.{ts,tsx,js}\" apps/renderer/src/lib/analytics-config.js apps/renderer/src/lib/pathname.js \"scripts/type-safety/*.mjs\" --max-warnings 0",
    "type-safety:cms": "eslint \"apps/cms/src/**/*.{ts,tsx}\" \"apps/cms/scripts/**/*.ts\" --max-warnings 0",
    "type-safety:landing": "eslint apps/landing/src --max-warnings 0",
    "type-safety:renderer": "eslint apps/renderer/src --max-warnings 0"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "@typescript-eslint/eslint-plugin": "8.71.1",
    "@typescript-eslint/parser": "8.71.1",
    "astro-eslint-parser": "3.2.0",
    "eslint": "10.12.0",
    "eslint-plugin-astro": "3.2.1",
    "typescript": "6.0.3"
  }
}
