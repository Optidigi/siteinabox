{
  "name": "siteinabox",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24.22.1 <25.0.0"
  },
  "scripts": {
    "check:ci": "node scripts/run-verification.mjs ci",
    "check:fast": "node scripts/run-verification.mjs fast",
    "check:toolchain": "node --test scripts/check-toolchain.test.mjs scripts/run-verification.test.mjs scripts/check-affected.test.mjs && node scripts/check-toolchain.mjs && node scripts/run-verification.mjs --check",
    "environment:check": "node --test scripts/check-environment-contract.test.mjs && node scripts/check-environment-inventory.mjs",
    "workflow:check": "node --test scripts/workflow-path-parser.test.mjs && node scripts/check-workflow-path-matrix.mjs",
    "workflow:actions:check": "node scripts/check-workflow-actions.mjs",
    "deployment:static-parity": "node scripts/check-static-deployment-parity.mjs",
    "cms:cleanup-test-data": "node scripts/cleanup-cms-test-data.mjs",
    "cms:cleanup-test-data:test": "node --test scripts/cleanup-cms-test-data.test.mjs",
    "cms:typecheck": "pnpm --dir apps/cms typecheck",
    "cms:test": "pnpm --dir apps/cms test",
    "cms:build": "pnpm --dir apps/cms build",
    "contracts:typecheck": "pnpm --dir packages/contracts typecheck",
    "docs:check": "node scripts/check-doc-links.mjs",
    "frontend:verify": "pnpm packages:typecheck && pnpm --dir apps/cms lint:ui-boundary && pnpm --dir apps/cms lint:ui-composition && pnpm --dir apps/cms lint:no-css",
    "landing:build": "pnpm --filter siteinabox-landing build",
    "landing:test": "pnpm --filter siteinabox-landing test",
    "legal:check": "pnpm --dir packages/legal-content check",
    "mcp:check": "node --test scripts/sync-mcp-config.test.mjs && node scripts/sync-mcp-config.mjs --check",
    "mcp:sync": "node scripts/sync-mcp-config.mjs",
    "packages:typecheck": "pnpm contracts:typecheck && pnpm ui:typecheck && pnpm site-renderer:typecheck",
    "renderer:build": "pnpm --dir apps/renderer build",
    "renderer:deploy-contract": "node scripts/check-renderer-deploy-contract.mjs",
    "renderer:test": "pnpm --dir apps/renderer test",
    "renderer:typecheck": "pnpm --dir apps/renderer typecheck",
    "site-renderer:typecheck": "pnpm --dir packages/site-renderer typecheck",
    "site:build": "pnpm landing:build",
    "site:test": "pnpm landing:test",
    "type-safety:check": "node --test scripts/check-type-safety.test.mjs && node scripts/check-type-safety.mjs",
    "type-safety:test": "node --test scripts/check-type-safety.test.mjs",
    "ui:typecheck": "pnpm --dir packages/ui typecheck",
    "cms:test:authorize": "node scripts/authorize-cms-test-resource.mjs",
    "cms:test:guard": "node --test scripts/cms-test-environment.test.mjs",
    "image:verify": "node scripts/verify-image.mjs",
    "publication:check": "node --test scripts/check-publication.test.mjs scripts/check-image-workflows.test.mjs && node scripts/check-image-workflows.mjs",
    "ci:policy:check": "node --test scripts/check-required-ci.test.mjs scripts/benchmark-ci.test.mjs scripts/cms-test-plan.test.mjs scripts/image-build-cache.test.mjs scripts/native-esbuild-install.test.mjs scripts/image-evidence.test.mjs scripts/image-archive-identity.test.mjs scripts/worker-runtime-evidence.test.mjs scripts/postgres-readiness.test.mjs scripts/inspect-delivery-controls.test.mjs && node scripts/check-required-ci.mjs --check",
    "delivery:inspect": "node scripts/inspect-delivery-controls.mjs",
    "infrastructure:check": "node --test scripts/infrastructure-images.test.mjs",
    "infrastructure:tunnel": "node scripts/verify-tunnel-offline.mjs",
    "dependency:policy:test": "node --test scripts/release-risk.test.mjs scripts/*dependency*.test.mjs scripts/inventory-image-native.test.mjs scripts/inspect-ci-evidence.test.mjs",
    "dependency:inventory": "node scripts/collect-dependency-evidence.mjs",
    "dependency:check": "node scripts/check-dependency-security.mjs",
    "dependency:release": "node scripts/check-dependency-security.mjs --release",
    "check:preflight": "node scripts/run-verification.mjs preflight",
    "check:cms-fast": "node scripts/run-verification.mjs cms-fast",
    "check:affected": "node scripts/check-affected.mjs",
    "dependency:compare": "node scripts/compare-dependency-evidence.mjs",
    "ci:receipts": "node scripts/inspect-ci-evidence.mjs"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "sass": "1.106.1",
    "yaml": "2.9.1"
  }
}
