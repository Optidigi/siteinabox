{
  "name": "@siteinabox/site-renderer",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "theme:generate": "tsx scripts/generate-theme-css.mjs",
    "test": "tsc --noEmit && tsx --test src/theme/*.test.mjs src/rich-text.test.mjs src/anchors.test.mjs src/blocks/all-blocks.test.mjs src/chrome/navbar.test.mjs src/chrome/footer.test.mjs src/chrome/consent.test.mjs",
    "typecheck": "tsc --noEmit"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./seo": {
      "types": "./src/seo/index.ts",
      "import": "./src/seo/index.ts",
      "default": "./src/seo/index.ts"
    },
    "./theme": {
      "types": "./src/theme/index.tsx",
      "import": "./src/theme/index.tsx",
      "default": "./src/theme/index.tsx"
    },
    "./theme/color-mode": {
      "types": "./src/theme/color-mode.ts",
      "import": "./src/theme/color-mode.ts",
      "default": "./src/theme/color-mode.ts"
    },
    "./theme/resolve": {
      "types": "./src/theme/resolve.ts",
      "import": "./src/theme/resolve.ts",
      "default": "./src/theme/resolve.ts"
    },
    "./hero-dither-effect": {
      "types": "./src/blocks/hero/hero-dither-effect.ts",
      "import": "./src/blocks/hero/hero-dither-effect.ts",
      "default": "./src/blocks/hero/hero-dither-effect.ts"
    },
    "./hero-ambient-effect": {
      "types": "./src/blocks/hero/hero-ambient-effect.ts",
      "import": "./src/blocks/hero/hero-ambient-effect.ts",
      "default": "./src/blocks/hero/hero-ambient-effect.ts"
    },
    "./hero-mesh-effect": {
      "types": "./src/blocks/hero/hero-mesh-effect.ts",
      "import": "./src/blocks/hero/hero-mesh-effect.ts",
      "default": "./src/blocks/hero/hero-mesh-effect.ts"
    },
    "./styles.css": "./src/styles.css"
  },
  "dependencies": {
    "@paper-design/shaders": "0.0.52",
    "@fontsource-variable/caveat": "^5.3.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/nunito": "5.3.0",
    "@siteinabox/contracts": "workspace:*",
    "@siteinabox/ui": "workspace:*",
    "lucide-react": "^1.31.0"
  },
  "peerDependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "pixelmatch": "^7.1.0",
    "playwright": "1.62.1",
    "pngjs": "^7.0.0",
    "tsx": "^4.23.12",
    "typescript": "6.0.3"
  }
}
